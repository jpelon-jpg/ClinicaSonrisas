# Copia este archivo como .env.local (no se sube al repositorio)
# URL base de la API. En producción Nginx sirve /api en el mismo dominio, así que se deja vacía.
VITE_API_URL=
# ID de cliente OAuth de Google (Google Cloud Console > Credenciales)
VITE_GOOGLE_CLIENT_ID=
# ID de la app de Facebook (developers.facebook.com)
VITE_FACEBOOK_APP_ID=
