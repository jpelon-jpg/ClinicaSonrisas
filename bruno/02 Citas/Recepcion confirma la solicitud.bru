meta {
  name: Recepcion confirma la solicitud
  type: http
  seq: 4
}

patch {
  url: {{baseUrl}}/citas/{{solicitudId}}/confirmar
  body: none
  auth: bearer
}

auth:bearer {
  token: {{tokenRecep}}
}

tests {
  test("pasa a CONFIRMADA (dispara correo, SMS y WhatsApp)", function () {
    expect(res.status).to.equal(200);
    expect(res.body.estado).to.equal("CONFIRMADA");
  });
}
