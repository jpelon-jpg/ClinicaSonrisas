meta {
  name: Login recepcionista
  type: http
  seq: 2
}

post {
  url: https://clinicasonrisas.online/api/auth/login
  body: json
  auth: none
}

body:json {
  {
    "email": "{{recepEmail}}",
    "password": "{{recepPassword}}"
  }
}

script:post-response {
  if (res.status === 200) {
    bru.setVar("tokenRecep", res.body.token);
  }
}

tests {
  test("responde 200 con un JWT", function () {
    expect(res.status).to.equal(200);
    expect(res.body.tipo).to.equal("Bearer");
    expect(res.body.token.split(".")).to.have.lengthOf(3);
  });
  test("el usuario tiene el rol RECEPCIONISTA", function () {
    expect(res.body.usuario.roles).to.include("RECEPCIONISTA");
  });
  test("la respuesta no expone la contraseña", function () {
    expect(JSON.stringify(res.body)).to.not.include("password");
  });
}
