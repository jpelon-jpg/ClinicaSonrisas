meta {
  name: Login paciente
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/auth/login
  body: json
  auth: none
}

body:json {
  {
    "email": "{{pacienteEmail}}",
    "password": "{{pacientePassword}}"
  }
}

script:post-response {
  if (res.status === 200) {
    bru.setVar("tokenPaciente", res.body.token);
  }
}

tests {
  test("responde 200 con un JWT", function () {
    expect(res.status).to.equal(200);
    expect(res.body.tipo).to.equal("Bearer");
    expect(res.body.token.split(".")).to.have.lengthOf(3);
  });
  test("el usuario tiene el rol PACIENTE", function () {
    expect(res.body.usuario.roles).to.include("PACIENTE");
  });
  test("la respuesta no expone la contraseña", function () {
    expect(JSON.stringify(res.body)).to.not.include("password");
  });
}
