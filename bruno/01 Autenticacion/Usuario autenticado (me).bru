meta {
  name: Usuario autenticado (me)
  type: http
  seq: 5
}

get {
  url: {{baseUrl}}/auth/me
  body: none
  auth: bearer
}

auth:bearer {
  token: {{tokenAdmin}}
}

tests {
  test("el JWT identifica al administrador", function () {
    expect(res.status).to.equal(200);
    expect(res.body.email).to.equal(bru.getEnvVar("adminEmail"));
  });
}
