meta {
  name: Disponibilidad de dentista
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/dentistas/1/disponibilidad?fecha={{fecha}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{tokenPaciente}}
}

script:pre-request {
  const d = new Date(); d.setDate(d.getDate() + 2);
  bru.setVar("fecha", d.toISOString().slice(0, 10));
}

tests {
  test("lista horarios libres y ocupados", function () {
    expect(res.status).to.equal(200);
    expect(res.body.horariosLibres).to.be.an("array");
  });
}
