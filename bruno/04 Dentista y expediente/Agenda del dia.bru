meta {
  name: Agenda del dia
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/dentista/agenda
  body: none
  auth: bearer
}

auth:bearer {
  token: {{tokenDentista}}
}

tests {
  test("agenda del dentista autenticado", function () {
    expect(res.status).to.equal(200);
    expect(res.body.citas).to.be.an("array");
  });
}
