# =====================================================================
# Sonrisa API - Configuración de ejemplo
# Copia este archivo como "application.properties" y llena los valores.
# application.properties NUNCA se sube al repositorio (.gitignore).
# =====================================================================
spring.application.name=sonrisa-api
server.port=8080

# ---------- Base de datos (MySQL 8) ----------
spring.datasource.url=jdbc:mysql://localhost:3306/sonrisa_db?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=America/Mexico_City
spring.datasource.username=CAMBIAR_USUARIO_BD
spring.datasource.password=CAMBIAR_PASSWORD_BD

# Las tablas se crean SOLO con Flyway (Hibernate no genera nada)
spring.jpa.hibernate.ddl-auto=none
spring.jpa.open-in-view=false
spring.jpa.properties.hibernate.default_batch_fetch_size=50
spring.jpa.properties.hibernate.jdbc.time_zone=America/Mexico_City
spring.flyway.enabled=true
spring.flyway.locations=classpath:db/migration

# ---------- Seguridad / JWT ----------
# Clave en Base64 de al menos 256 bits. Genérala con: openssl rand -base64 48
app.jwt.secret=CAMBIAR_CLAVE_BASE64
app.jwt.expiration-minutes=480
app.cors.allowed-origins=http://localhost:5173
app.frontend-url=http://localhost:5173

# Datos de prueba (DataSeeder). Ponlo en false cuando ya existan datos.
app.seed.enabled=true

# ---------- Inicio de sesión social ----------
app.oauth.google.client-id=CAMBIAR_GOOGLE_CLIENT_ID.apps.googleusercontent.com
app.oauth.facebook.app-id=CAMBIAR_FACEBOOK_APP_ID
app.oauth.facebook.app-secret=CAMBIAR_FACEBOOK_APP_SECRET

# ---------- Correo (Postfix local del VPS) ----------
spring.mail.host=localhost
spring.mail.port=25
spring.mail.properties.mail.smtp.auth=false
spring.mail.properties.mail.smtp.starttls.enable=false
app.mail.from=Sonrisa Clínica Dental <no-responder@TU-DOMINIO>
# En tu computadora déjalas en false; en el VPS ponlas en true.
app.notificaciones.email.enabled=false

# ---------- Twilio (SMS y WhatsApp) ----------
app.twilio.account-sid=
app.twilio.auth-token=
app.twilio.sms-from=
app.twilio.sms-template=sms_appointment_reminders
app.twilio.whatsapp-from=
app.twilio.whatsapp-content-sid=
app.notificaciones.sms.enabled=true
app.notificaciones.whatsapp.enabled=false


app.whatsapp.meta.token=
app.whatsapp.meta.phone-id=
app.whatsapp.meta.api-version=v25.0
app.whatsapp.meta.template=hello_world
app.whatsapp.meta.language=en_US
app.whatsapp.meta.mexico-agrega-1=false

